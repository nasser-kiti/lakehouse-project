# Databricks workspace (dbt and the landing upload both read these)
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=<personal-access-token>

# Landing volume: /Volumes/<catalog>/<schema>/<volume>
LAKEHOUSE_CATALOG=lakehouse_one
LAKEHOUSE_LANDING_SCHEMA=landing
LAKEHOUSE_LANDING_VOLUME=raw
